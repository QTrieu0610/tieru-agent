# Canonical Tieru environment. WAKU_* remains a deprecated fallback; do not set both.
# ── Provider ────────────────────────────────────────────────────────────────
# Pick one provider for the default role. Tieru is model-independent; roles can
# use different providers in YAML, and the ollama-gemma4-e2b profile is keyless.
#   anthropic (default) · ollama (keyless local) · openai · gemini · deepseek · minimax · kimi · glm · openrouter · opencode_zen · opencode_go
# No paid key? openrouter's default models are $0 ":free" ids (rate-limited).
TIERU_PROVIDER=anthropic

# Keys — only the one for your chosen provider is needed.
# (Keep comments on their own line: python-dotenv reads inline text as the value.)
# anthropic → https://console.anthropic.com
ANTHROPIC_API_KEY=
# openai → https://platform.openai.com
OPENAI_API_KEY=
# gemini → https://aistudio.google.com
GEMINI_API_KEY=
# deepseek → https://platform.deepseek.com
DEEPSEEK_API_KEY=
# minimaxi → https://platform.minimaxi.com
MINIMAX_API_KEY=
# kimi → https://platform.moonshot.ai
MOONSHOT_API_KEY=
# glm → https://z.ai
ZHIPU_API_KEY=
# openrouter (one key, hundreds of hosted models) → https://openrouter.ai/keys
OPENROUTER_API_KEY=
# xai / grok → https://console.x.ai
XAI_API_KEY=
# opencode zen → https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=
# opencode go → https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=

# ── Models (optional) ───────────────────────────────────────────────────────
# Each provider has sensible defaults (see tieru/loop/models.py PROVIDERS):
#   anthropic:  claude-sonnet-5              + claude-haiku-4-5 (gate/summarizer)
#   openai:     gpt-5.3-chat-latest          + gpt-4.1-mini
#   ollama:     gemma4:e2b                   + gemma4:e2b (keyless, local)
#   gemini:     gemini-3.5-flash             + gemini-3.1-flash-lite
#   deepseek:   deepseek-v4-pro              + deepseek-v4-pro
#   minimax:    MiniMax-M3                   + MiniMax-M2
#   kimi:       kimi-k3                      + kimi-k2.6 (gate/summarizer)
#               (K3-only key? set TIERU_SMALL_MODEL=kimi-k3 too)
#   glm:        glm-5.2                      + glm-5-turbo
#   openrouter: nemotron-3-super:free        + gemma-4-26b:free (both $0,
#               rate-limited; Settings lists the live catalog, free first)
# openrouter's whole point is picking a different model, so TIERU_MODEL takes
# any "<vendor>/<model>" slug from https://openrouter.ai/models — e.g.
# TIERU_MODEL=meta-llama/llama-3.1-70b-instruct
# Override here if you want something else — they're just strings:
# TIERU_MODEL=
# TIERU_SMALL_MODEL=
# Advanced: point at any compatible endpoint / bring your own key var:
# TIERU_BASE_URL=
# TIERU_API_KEY=

# ── Tieru home (optional) ──────────────────────────────────────────────────
# Where memory (state.db), calendar.ics, outbox/ and traces/ live.
# TIERU_HOME=.tieru

# ── Loop guardrails (optional) ──────────────────────────────────────────────
# TIERU_MAX_ITERATIONS=10
# TIERU_MAX_TOKENS=2048
# Working memory window: how many recent turns enter the prompt (default 12).
# Older turns stay in state.db; explicitly enabled consolidation and the retrieval gate bring them
# back when relevant. Caps context/cost/latency on long (esp. Telegram) threads.
# TIERU_HISTORY_TURNS=12

# ── Memory tuning (optional) ────────────────────────────────────────────────
# Long-term writes are explicit by default. Opt into model consolidation deliberately.
# TIERU_MEMORY_WRITE_POLICY=explicit
# TIERU_MEMORY_MAX_RECORDS=10000
# When policy is "consolidate", wait for N new exchanges.
# TIERU_CONSOLIDATE_EVERY=6
# TIERU_RETRIEVAL_TOP_K=4

# ── Tracing (optional): pip install -e '.[tracing]' ────────────────────────
# JSONL traces are ALWAYS written to $TIERU_HOME/traces/. To also see them in
# a dashboard: run `make trace` (Phoenix on localhost:6006) and uncomment:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# (Langfuse cloud speaks OTel too — use their endpoint + auth headers instead.)

# ── Apple ecosystem (optional, macOS) ───────────────────────────────────────
# Sync created events into Calendar.app (a dedicated "Tieru" calendar):
# TIERU_APPLE_CALENDAR=1
# Give the agent read/write tools for Calendar, Mail, Reminders, Notes — so it
# can brief you on your real week ("brief me"). First use triggers the macOS
# Automation permission prompts for each app.
# TIERU_APPLE_TOOLS=1
# Limit calendar reads to named calendars (faster; comma-separated):
# TIERU_APPLE_CALENDARS=Work,Home

# ── GitHub, read-only (optional) ────────────────────────────────────────────
# Lets the agent read pull requests and issues through the `gh` CLI. There is
# no token here: gh keeps its own credentials, so run `gh auth login` once and
# nothing sensitive lands in this file. The tool is READ-ONLY by construction —
# it can list/view PRs and issues and read a diff, and refuses to merge,
# comment, close or push. Off by default because every registered tool ships in
# every prompt, and this is maintainer capability, not assistant capability.
# TIERU_GH_TOOL=1
# Repo to assume when a call omits one (for running outside a checkout):
# TIERU_GH_REPO=QTrieu0610/tieru-agent

# ── Google Calendar writes (optional): pip install -e '.[gcal]' ────────────
# SQLite + calendar.ics remain the source of truth. This only mirrors events
# created by create_event; list_events stays local and requests use sendUpdates=none.
# Authenticate first with Application Default Credentials, then enable:
# TIERU_GOOGLE_CALENDAR=1
# TIERU_GOOGLE_CALENDAR_ID=primary

# ── Open files in your editor (optional) ────────────────────────────────────
# Dashboard "reveal" links open files in this editor when it's on PATH
# (falls back to cursor, then code, then Finder):
# TIERU_EDITOR=cursor

# ── Experimental tools (optional) ───────────────────────────────────────────
# delegate_task (LIVE): hand coding jobs to pi, the open-source coding agent —
#   npm install -g --ignore-scripts @earendil-works/pi-coding-agent
# The terminal/browser/cron skeletons still just report "coming soon".
# TIERU_EXPERIMENTAL=1
# Graph workflows: triage every message through a graph (small-model classify +
# calendar peek in parallel -> quick reply, or the normal loop as a node).
# Fails open to the plain loop on any error. See tieru/graph/.
# TIERU_GRAPH_WORKFLOWS=1
# Passive repeated-workflow suggestions over completed Replay. Opt in explicitly.
# TIERU_SHADOW_ENABLED=false
# TIERU_SHADOW_MIN_OCCURRENCES=3
# TIERU_SHADOW_MAX_EVIDENCE_RUNS=5
# TIERU_SHADOW_SUGGESTIONS=true
# TIERU_SHADOW_SNOOZE_DAYS=7
# TIERU_SHADOW_STALE_DAYS=30
# Model Fabric v2 preserves execution modes and adds policy-first selection
# among YAML-enabled candidates. It stays disabled and local-first on upgrade.
# TIERU_FABRIC_ENABLED=false
# TIERU_FABRIC_DEFAULT_MODE=standard
# TIERU_FABRIC_USE_SMALL_CLASSIFIER=false
# TIERU_FABRIC_ROUTING_POLICY=local_first
# TIERU_FABRIC_AVAILABILITY_TTL_SECONDS=60
# TIERU_FABRIC_MIN_HISTORY_SAMPLES=5
# TIERU_FABRIC_MAX_FALLBACKS=1
# TIERU_FABRIC_QUICK_MAX_TOKENS=512
# TIERU_FABRIC_QUICK_MAX_ITERATIONS=1
# TIERU_FABRIC_QUICK_HISTORY_TURNS=2
# TIERU_FABRIC_AGENT_MAX_TOKENS=4096
# TIERU_FABRIC_AGENT_MAX_ITERATIONS=10
# TIERU_FABRIC_DEEP_MAX_TOKENS=12288
# TIERU_FABRIC_DEEP_MAX_ITERATIONS=12
# TIERU_FABRIC_DEEP_HISTORY_TURNS=24
# TIERU_FABRIC_DEEP_VERIFICATION=true
# Max seconds pi may spend on one delegated task (default 300):
# TIERU_DELEGATE_TIMEOUT=300

# ── Web search (optional) ───────────────────────────────────────────────────
# The search_web tool works keyless via DuckDuckGo, but that endpoint often
# blocks automated requests. For reliable search (e.g. the "find the World Cup
# games left and add them to my calendar" loop demo), set a free Tavily key:
#   sign up at https://tavily.com → copy the key here.
# TAVILY_API_KEY=

# ── MCP servers (optional): pip install -e '.[mcp]' ─────────────────────────
# Connect Model Context Protocol servers by creating .tieru/mcp.json:
#   {"servers": [{"name": "fs", "command": "npx",
#                 "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]}]}
# Starting each server requires Trust authorization for process_execution.
# Its tools then register as <server>_<tool>; unclassified calls remain denied.

# ── Voice gateway (optional): pip install -e '.[voice]' ────────────────────
# Unset = push-to-talk (Enter, speak, Enter). Set a wake word — ANY phrase —
# and `make voice` becomes always-listening:
# TIERU_WAKE_WORD=hey tieru
# What it says when it wakes:
# TIERU_WAKE_ACK=Yes?
# Stay in the conversation after answering (Siri-style) for N seconds before
# needing "hey tieru" again:
# TIERU_FOLLOWUP_SECONDS=8
# STT model (tiny/base/small — bigger = more accurate, slower):
# TIERU_WHISPER_MODEL=base
# TTS engine: 'say' (macOS built-in, default) or 'kokoro' (neural British
# butler — first: pip install kokoro soundfile):
# TIERU_TTS=say
# TIERU_VOICE=Daniel
# (for kokoro use voices like bm_george / bm_fable)
# Mic sensitivity: lower if it never hears you, higher if it wakes on noise:
# TIERU_MIC_THRESHOLD=0.005

# ── Reliability (optional) ──────────────────────────────────────────────────
# Max seconds any single LLM call may take before erroring instead of hanging:
# TIERU_LLM_TIMEOUT=120

# ── Telegram gateway (optional): pip install -e '.[telegram]' ──────────────
# Create a bot: message @BotFather → /newbot. Never commit the real token.
# TELEGRAM_BOT_TOKEN=
# Single allowed numeric user ID (backward compatibility).
# TELEGRAM_ALLOWED_USER=
# Comma-separated Telegram numeric user IDs. Both allowlists are merged.
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Discord gateway (optional): pip install -e '.[discord]' ────────────────
# Create a bot in the Discord Developer Portal and enable Message Content Intent.
#
# READ THIS: the bot answers out of YOUR memory, with YOUR tools, on YOUR key.
# Default posture is deny: no DM or server channel is answered until an allowed
# user is named below. Every message it answers is a billed agent turn, and its
# chat log feeds consolidation, so a stranger's message can become a permanent
# fact in your memory. Open it up one line at a time.
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USER=          # required comma-separated ids. Empty = nobody.
# DISCORD_ALLOWED_CHANNEL=       # comma-separated channel ids. Empty = no channel.
# DISCORD_REQUIRE_MENTION=1      # in a channel, only reply when @-mentioned
# DISCORD_MAX_TURNS_PER_HOUR=30  # hard spend ceiling across all users
# DISCORD_HOME=.tieru-discord     # a SEPARATE memory — use this for any shared server
# ── WhatsApp gateway (optional): pip install -e '.[whatsapp]' ──────────────
# Meta Cloud API access token (temporary: 24h, permanent via System User).
# See tieru/gateway/whatsapp.py docstring for full setup guide.
# WHATSAPP_TOKEN=
# Phone Number ID from WhatsApp > Getting Started in your Meta app dashboard.
# WHATSAPP_PHONE_NUMBER_ID=
# App Secret from your app's Settings → Basic → App Secret.
# Required: Meta signs every webhook with this; without it, anyone who finds
# your URL can forge payloads and drive the agent.
# WHATSAPP_APP_SECRET=
# Any random string — you'll enter it in Meta's webhook config page.
# WHATSAPP_VERIFY_TOKEN=
# Required: lock the gateway to one phone number (without '+' prefix).
# WHATSAPP_ALLOWED_PHONE=
# Reject larger webhook bodies before reading them (default 1 MiB; max 10 MiB).
# WHATSAPP_MAX_BODY_BYTES=1048576

# ── Supabase vector memory (optional): pip install -e '.[supabase]' ────────
# The launch-rag upgrade path: run sql/init_supabase.sql on a fresh project.
# Embeddings use OPENAI_API_KEY above. The model must be configured explicitly.
# TIERU_SEMANTIC_STORE=supabase
# TIERU_EMBEDDING_MODEL=text-embedding-3-small
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# â”€â”€ Restricted browser (optional): pip install -e '.[browser]' â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Then run: playwright install chromium. Private/local addresses remain blocked.
# TIERU_BROWSER_ENABLED=0
# TIERU_BROWSER_ALLOWED_DOMAINS=example.com,docs.example.com
# TIERU_BROWSER_TIMEOUT_SECONDS=15
# TIERU_BROWSER_MAX_ACTIONS=20

# ── Notion episodic memory (optional): pip install -e '.[notion]' ───────────
# Store episodes (dated memory summaries) in a Notion database instead of the
# local state.db. Create an integration at https://www.notion.so/my-integrations,
# share a database with it (properties: Name = title, Summary = rich text), then
# paste its copied Notion link below (a raw database ID also works):
# TIERU_EPISODIC_STORE=notion
# NOTION_TOKEN=ntn_...
# NOTION_EPISODES_DATABASE_ID=https://app.notion.com/p/...
