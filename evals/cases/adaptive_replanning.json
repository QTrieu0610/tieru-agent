{
  "schema_version": 1,
  "corpus_version": "m22-adaptive-replanning-v1",
  "cases": [
    {
      "case_id": "replan-root-cause-001",
      "category": "adaptive_replanning",
      "goal": "Fix authentication failure by inspecting handler and applying appropriate fix.",
      "setup": {
        "files": {
          "auth_handler.py": "# Auth handler is correct\n",
          "migration.sql": "-- Missing column\n"
        },
        "fake_tools": [
          {"name": "inspect_file", "read_only": true},
          {"name": "apply_patch", "read_only": false, "capabilities": ["local_write"]}
        ],
        "script": [
          {
            "position": 1,
            "title": "Inspect authentication handler",
            "tool_calls": [{"name": "inspect_file", "args": {"path": "auth_handler.py"}}],
            "final_output": "Auth handler is correct. Actual issue is database migration mismatch.",
            "verification": "pass",
            "plan_review": {
              "decision": "revise_remaining",
              "reason": "Auth handler is not root cause; database migration is the real issue.",
              "remaining_steps": [
                {
                  "title": "Apply database migration fix",
                  "instruction": "Fix migration mismatch in migration.sql",
                  "verification": "Check migration applied"
                }
              ]
            }
          },
          {
            "position": 2,
            "title": "Modify authentication handler",
            "final_output": "superseded step should not execute"
          },
          {
            "position": 3,
            "title": "Apply database migration fix",
            "tool_calls": [{"name": "apply_patch", "args": {"path": "migration.sql", "content": "-- Migration fixed\n"}}],
            "final_output": "Applied database migration fix successfully.",
            "verification": "pass"
          }
        ]
      },
      "expected": {
        "task_status": "completed",
        "required_events": ["task_plan_revised", "task_step_superseded", "task_completed"],
        "expected_artifacts": ["migration.sql"],
        "verification_status": "pass",
        "ground_truth_success": true
      },
      "max_steps": 4,
      "max_model_calls": 4,
      "max_tool_calls": 4,
      "tags": ["m22", "root_cause"]
    },
    {
